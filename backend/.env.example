DSH_SSO_SECRET=
DSH_EMBED_ORIGIN=http://30.251.255.142:8080
DSH_INTERNAL_URL=http://127.0.0.1:3081
# 142 设 true：关闭页内 AI，改走「我的助手」起草+确认
# AGENT_NATIVE=true
# 长期记忆：默认 V1 关键词。模型+Base 都填才启用 V2 向量检索（OpenAI 兼容 embeddings）
# 也可用系统设置 → 模型管理 → 长期记忆·向量模型（库配置优先于本文件）
# 本地/自建示例：
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# EMBEDDING_API_KEY=
# OpenRouter 免费向量示例（密钥勿提交 git）：
