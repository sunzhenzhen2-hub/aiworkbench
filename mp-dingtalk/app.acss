/* 与 PC 端 theme.css 同一套颜色：白底、浅灰卡片、薄荷绿点缀 */
page {
  background: #fafafa;
  color: #222222;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #ebebeb;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.04);
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 8rpx;
}

.page-desc {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 24rpx;
}

.muted {
  color: #999999;
  font-size: 24rpx;
}

.btn {
  background: #222222;
  color: #ffffff;
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx;
  font-weight: 500;
}

.btn-ghost {
  background: #f5f5f5;
  color: #222222;
  border-radius: 999rpx;
  text-align: center;
  padding: 22rpx;
  margin-top: 16rpx;
}

.btn-mint {
  background: #e8f5ef;
  color: #4aa67d;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  color: #666666;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.input {
  background: #fafafa;
  border: 1rpx solid #ebebeb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.empty {
  text-align: center;
  color: #999999;
  padding: 80rpx 0;
}

.deny {
  background: #fff6f6;
  color: #c45656;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  background: #e8f5ef;
  color: #4aa67d;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
}

.tag-warn {
  background: #fdeaea;
  color: #c45656;
}
