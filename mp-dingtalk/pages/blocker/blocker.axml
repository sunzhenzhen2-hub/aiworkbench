<view class="page">
  <view class="page-title">新增卡点</view>
  <view class="page-desc">把卡住进度的事记下来，并写下一步</view>
  <view a:if="{{denyMessage}}" class="deny">{{denyMessage}}</view>

  <view class="field">
    <view class="field-label">项目</view>
    <searchable-picker
      names="{{projectNames}}"
      index="{{projectIndex}}"
      placeholder="输入关键字搜索项目"
      onChange="onProject"
    />
  </view>
  <view class="field">
    <view class="field-label">卡点描述</view>
    <textarea class="input" value="{{description}}" onInput="onDesc" placeholder="发生了什么" />
  </view>
  <view class="field">
    <view class="field-label">责任方</view>
    <input class="input" value="{{responsible_party}}" onInput="onParty" placeholder="内部同事或外部合作方" />
  </view>
  <view class="field">
    <view class="field-label">下一步</view>
    <input class="input" value="{{next_action}}" onInput="onNext" placeholder="接下来要做什么" />
  </view>
  <view class="field">
    <view class="field-label">下次跟进</view>
    <view class="input" onTap="pickDate">{{next_follow_up || '选择日期'}}</view>
  </view>
  <view class="btn" onTap="submit">提交</view>
</view>
