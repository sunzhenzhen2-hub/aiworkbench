<view class="page">
  <view class="page-title">项目支撑工作台</view>
  <view class="page-desc">{{user.name ? '你好，' + user.name : '钉钉轻端'}}</view>

  <view a:if="{{denyMessage}}" class="deny">{{denyMessage}}</view>

  <view a:else class="stats">
    <view class="card stat">
      <text class="num">{{stats.total_projects || 0}}</text>
      <text class="label">项目</text>
    </view>
    <view class="card stat">
      <text class="num warn">{{stats.red_count || 0}}</text>
      <text class="label">风险</text>
    </view>
    <view class="card stat">
      <text class="num">{{stats.pending_blockers || 0}}</text>
      <text class="label">卡点</text>
    </view>
  </view>

  <view class="card menu-item" onTap="goTodo">我的待办</view>
  <view class="card menu-item" onTap="goBlocker">新增卡点</view>
  <view class="card menu-item" onTap="goReport">提交周报</view>
</view>
