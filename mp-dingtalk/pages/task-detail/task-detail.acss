.timeline { margin-top: 16rpx; }
.event {
  border-left: 4rpx solid #5bb98c;
  padding: 8rpx 0 16rpx 20rpx;
  margin-left: 8rpx;
}
.event-time { font-size: 22rpx; color: #999; }
.event-body { font-size: 26rpx; margin-top: 4rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.chip {
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.chip.on { background: #e8f5ef; color: #4aa67d; }
.assist { font-size: 24rpx; color: #666; margin: 8rpx 0; }
.btn-row { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn-secondary {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  color: #333;
}
