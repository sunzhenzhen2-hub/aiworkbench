.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0 12rpx;
}
.item-title { font-weight: 500; margin-bottom: 8rpx; }
.row { display: flex; gap: 12rpx; margin-top: 16rpx; flex-wrap: wrap; }
.row-actions { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.btn-mini {
  background: #f5f5f5;
  color: #222;
  border-radius: 12rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.btn-mini.primary { background: #5bb98c; color: #fff; }
.chip {
  background: #f5f5f5;
  color: #222;
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
}
.chip.on { background: #e8f5ef; color: #4aa67d; }
