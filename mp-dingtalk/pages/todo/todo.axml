<view class="page">
  <view class="page-title">我的待办</view>
  <view class="page-desc">任务交办与卡点跟进（与电脑端同步）</view>
  <view a:if="{{denyMessage}}" class="deny">{{denyMessage}}</view>

  <view class="row-actions">
    <view class="btn-mini" onTap="goCreateSelf">自建任务</view>
    <view a:if="{{canAssign}}" class="btn-mini primary" onTap="goCreateDelegated">交办任务</view>
  </view>

  <view class="section-title">任务</view>
  <view a:if="{{tasks.length === 0}}" class="empty">暂无待办任务</view>
  <view a:for="{{tasks}}" class="card" onTap="goDetail" data-id="{{item.id}}">
    <view class="item-title">{{item.title}}</view>
    <view class="muted">{{item.project_name}} · {{item.typeLabel}} · {{item.roleLabel}}</view>
    <view class="muted">负责人 {{item.assignee.name}} · {{item.statusLabel}} · {{item.due_date || '无截止日期'}}</view>
  </view>

  <view class="section-title">卡点跟进</view>
  <view a:if="{{blockers.length === 0}}" class="empty">暂无跟进卡点</view>
  <view a:for="{{blockers}}" class="card">
    <view class="item-title">{{item.description}}</view>
    <view class="muted">下次跟进：{{item.next_follow_up}}</view>
    <text class="tag {{item.is_follow_up_overdue ? 'tag-warn' : ''}}">{{item.statusLabel}}</text>
    <view class="row">
      <view class="chip" onTap="setBlockerStatus" data-id="{{item.id}}" data-status="following">跟进中</view>
      <view class="chip" onTap="setBlockerStatus" data-id="{{item.id}}" data-status="pending_decision">待决策</view>
      <view class="chip" onTap="setBlockerStatus" data-id="{{item.id}}" data-status="resolved">已解决</view>
    </view>
  </view>

  <view class="btn" onTap="goBlocker">新增卡点</view>
</view>
